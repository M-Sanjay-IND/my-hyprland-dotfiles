{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "height": 38,
  "spacing": 6,
  "fixed-center": true,
  "ipc": true,
  "margin-top": 6,
  "margin-left": 14,
  "margin-right": 14,

  // ─── TOP BAR LAYOUT (macOS Floating Island Style) ─────────────────────────
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock",
    "custom/weather"
  ],

  "modules-right": [
    "group/hardware",
    "group/control",
    "battery",
    "custom/idle-inhibitor",
    "custom/control-center",
    "custom/power"
  ],

  // ─── LEFT MODULES ────────────────────────────────────────────────────────
  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "App Launcher (SUPER + Space)",
    "on-click": "~/.local/bin/rofi-launcher -show drun"
  },

  "hyprland/workspaces": {
    "all-outputs": true,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": true,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "class<firefox|org.mozilla.firefox|librewolf|floorp|cachy-browser>": "󰈹",
      "class<zen>":                        "󰰷",
      "class<Chromium|Thorium|chrome>":    "󰊯",
      "class<kitty|konsole|alacritty>":    "󰄛",
      "class<VSCode|code|VSCodium>":       "󰨞",
      "class<subl>":                       "󰅳",
      "class<obsidian>":                   "󰎕",
      "class<spotify>":                    "󰓇",
      "class<discord|vesktop|webcord>":    "󰙯",
      "class<thunar|dolphin|nemo>":        "󰉋",
      "class<steam>":                      "󰓓",
      "class<mpv|vlc>":                    "󰕼",
      "class<gimp>":                       "󰏺"
    },
    "persistent-workspaces": { "*": 1 }
  },

  "hyprland/window": {
    "format": "{}",
    "icon": true,
    "icon-size": 15,
    "max-length": 45,
    "separate-outputs": true,
    "rewrite": {
      "": "Desktop"
    }
  },

  // ─── CENTER MODULES ──────────────────────────────────────────────────────
  "clock": {
    "format": "󰃭 {:%a %b %e   󰥔 %I:%M %p}",
    "format-alt": "󰃭 {:%Y-%m-%d   󰥔 %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months":   "<span color='#c6a0f6'><b>{}</b></span>",
        "weekdays": "<span color='#a5adcb'><b>{}</b></span>",
        "today":    "<span color='#f5bde6'><b>{}</b></span>",
        "days":     "<span color='#cad3f5'>{}</span>"
      }
    }
  },

  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 1800,
    "return-type": "json",
    "tooltip": true,
    "hide-empty-text": true
  },

  // ─── RIGHT MODULES ───────────────────────────────────────────────────────
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory",
      "custom/temp"
    ]
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)"
  },

  "custom/temp": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/temp.sh",
    "interval": 5,
    "return-type": "json",
    "tooltip": true
  },

  "group/control": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "pulseaudio",
      "backlight"
    ]
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰤭 Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr} (Signal: {signalStrength}%)",
    "on-click": "kitty --class floating-tool -e nmtui"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled": "󰂲",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "on-click": "sh -c 'command -v bluetuith >/dev/null && kitty --class floating-tool -e bluetuith || kitty --class floating-tool -e bluetoothctl'"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 2,
    "max-volume": 150,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol",
    "tooltip-format": "Volume: {volume}%"
  },

  "backlight": {
    "device": "amdgpu_bl2",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brightness: {percent}%"
  },

  "battery": {
    "states": {
      "good": 90,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}% ({timeTo})\nPower: {power:0.1f}W"
  },

  "custom/idle-inhibitor": {
    "format": "{}",
    "exec": "pgrep -x hypridle > /dev/null && echo '󰒲' || echo '☕'",
    "on-click": "~/.config/waybar/scripts/idle-toggle.sh",
    "signal": 8,
    "tooltip": true,
    "tooltip-format": "Idle Inhibitor: Click to toggle keep-awake"
  },

  "custom/control-center": {
    "format": "󰂚",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "return-type": "json",
    "tooltip-format": "Notifications · Left-click: Open · Right-click: Toggle DND",
    "escape": true
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power Menu (SUPER + Escape)",
    "on-click": "wlogout -p layer-shell -C ~/.config/wlogout/style.css -l ~/.config/wlogout/layout -b 5"
  }
}
