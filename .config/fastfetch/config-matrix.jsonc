{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "green",
      "2": "bright_green"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ➜  ",
    "color": {
      "separator": "green"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "  \u001b[1;32m󰣇 {user-name-colored}\u001b[0m@\u001b[1;32m{host-name-colored}\u001b[0m"
    },
    {
      "type": "custom",
      "format": "  \u001b[1;30m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "  󰒋 Kernel",
      "keyColor": "bright_green"
    },
    {
      "type": "wm",
      "key": "   Desktop",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "bright_green"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "green"
    },
    {
      "type": "uptime",
      "key": "  󰅐 Uptime",
      "keyColor": "bright_green"
    },
    {
      "type": "packages",
      "key": "  󰏖 Packages",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "  \u001b[1;30m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "cpu",
      "key": "   CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "  󰢮 GPU",
      "keyColor": "bright_green"
    },
    {
      "type": "memory",
      "key": "  󰍛 Memory",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  󰋊 Storage",
      "keyColor": "bright_green"
    },
    {
      "type": "custom",
      "format": "  \u001b[1;30m──────────────────────────────────────────────\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2
    }
  ]
}
